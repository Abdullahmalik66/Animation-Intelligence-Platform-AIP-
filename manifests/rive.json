{
  "id": "rive",
  "purpose": "Designer-authored interactive graphics with state machines, inputs, and data binding.",
  "triggers": [
    "interactive character",
    ".riv asset",
    "state machine",
    "designer interactive asset"
  ],
  "exclusions": [
    "static/linear designer export (lottie)",
    "DOM/SVG motion (css/gsap/motion)",
    "3D (threejs)"
  ],
  "required_shared_modules": [
    "GOV-VERSION",
    "GOV-OWNERSHIP",
    "GOV-A11Y",
    "GOV-SECURITY",
    "GOV-READINESS",
    "GOV-CONFIDENCE",
    "GOV-DEPTH"
  ],
  "canonical_skill": "skills/rive/SKILL.md",
  "modules": [
    {
      "id": "rive.package-gate",
      "source": "skills/rive/SKILL.md",
      "sections": [
        "Version and Package Gate",
        "Asset Schema Evidence"
      ],
      "load_when": [
        "implementation",
        "debugging",
        "code-review"
      ],
      "required": true
    },
    {
      "id": "rive.state-machine",
      "source": "skills/rive/SKILL.md",
      "sections": [
        "Few-Shot Examples"
      ],
      "load_when": [
        "implementation:inputs",
        "implementation:data-binding"
      ],
      "required": false
    },
    {
      "id": "rive.ownership",
      "source": "skills/rive/SKILL.md",
      "sections": [
        "Ownership and Cleanup Contract",
        "Resize and Resolution"
      ],
      "load_when": [
        "implementation",
        "debugging",
        "code-review"
      ],
      "required": true
    },
    {
      "id": "rive.wasm-csp",
      "source": "skills/rive/SKILL.md",
      "sections": [
        "WASM, CSP, and Runtime Delivery"
      ],
      "load_when": [
        "security-review",
        "implementation",
        "deployment-question"
      ],
      "required": false
    },
    {
      "id": "rive.a11y-ext",
      "source": "skills/rive/SKILL.md",
      "sections": [
        "Accessibility Contract"
      ],
      "load_when": [
        "implementation",
        "accessibility-review"
      ],
      "required": false
    }
  ],
  "workflows": [
    "implementation",
    "code-review",
    "debugging",
    "accessibility-review",
    "security-review",
    "production-readiness"
  ],
  "example_tags": [
    "rive",
    "state-machine"
  ],
  "evidence_requirements": [
    "exact package + version",
    "renderer backend",
    "WASM delivery",
    ".riv schema (SM/input/VM names+types)",
    "asset origin/integrity"
  ],
  "implementation_blockers": [
    "unknown package/exports",
    "unknown state-machine or input names/types",
    "unverified data-binding APIs"
  ],
  "readiness_requirements": [
    "package+schema verified",
    "verified teardown",
    "single resize owner",
    "WASM/CSP fallback",
    "keyboard parity",
    "meaningful reduced-motion state"
  ]
}
