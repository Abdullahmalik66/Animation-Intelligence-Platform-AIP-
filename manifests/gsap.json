{
  "id": "gsap",
  "purpose": "Complex code-driven orchestration: timelines, ScrollTrigger, pinning, sequencing.",
  "triggers": [
    "scroll-driven",
    "timeline sequence",
    "pinning",
    "complex orchestration",
    "scrubbed animation"
  ],
  "exclusions": [
    "simple hover/fade (CSS)",
    "designer-authored asset (lottie/rive)",
    "3D (threejs)",
    "React declarative presence (motion-react)"
  ],
  "required_shared_modules": [
    "GOV-VERSION",
    "GOV-OWNERSHIP",
    "GOV-A11Y",
    "GOV-READINESS",
    "GOV-CONFIDENCE",
    "GOV-DEPTH"
  ],
  "canonical_skill": "skills/gsap/SKILL.md",
  "modules": [
    {
      "id": "gsap.core-integration",
      "source": "skills/gsap/SKILL.md",
      "sections": [
        "Goal",
        "Version and Package Gate",
        "Lifecycle and Cleanup Strategy"
      ],
      "load_when": [
        "implementation",
        "code-review",
        "debugging"
      ],
      "required": true
    },
    {
      "id": "gsap.scrolltrigger",
      "source": "skills/gsap/SKILL.md",
      "sections": [
        "ScrollTrigger"
      ],
      "load_when": [
        "intent:scroll",
        "debugging:scrolltrigger"
      ],
      "required": false
    },
    {
      "id": "gsap.react",
      "source": "integrations/react/README.md",
      "sections": [
        "GSAP"
      ],
      "load_when": [
        "framework:react"
      ],
      "required": false
    },
    {
      "id": "gsap.a11y-ext",
      "source": "skills/gsap/SKILL.md",
      "sections": [
        "Accessibility"
      ],
      "load_when": [
        "implementation",
        "accessibility-review"
      ],
      "required": false
    },
    {
      "id": "gsap.debugging",
      "source": "skills/gsap/SKILL.md",
      "sections": [
        "Debugging Guidance"
      ],
      "load_when": [
        "debugging"
      ],
      "required": false
    }
  ],
  "workflows": [
    "implementation",
    "code-review",
    "debugging",
    "accessibility-review",
    "performance-review",
    "migration",
    "production-readiness"
  ],
  "example_tags": [
    "gsap",
    "stagger",
    "scrolltrigger"
  ],
  "evidence_requirements": [
    "gsap version",
    "plugin registration",
    "framework version",
    "cleanup owner (gsap.context / ctx.revert)"
  ],
  "implementation_blockers": [
    "unknown gsap version",
    "unverified plugin availability"
  ],
  "readiness_requirements": [
    "version verified",
    "context-scoped cleanup",
    "reduced-motion via matchMedia",
    "no pinning under reduction"
  ]
}
