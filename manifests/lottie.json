{
  "id": "lottie",
  "purpose": "Designer-authored static/linear vector animation playback.",
  "triggers": ["after effects export", ".json animation asset", "designer linear animation"],
  "exclusions": ["interactive state machines (rive)", "code-driven motion (css/gsap/motion)"],
  "required_shared_modules": ["GOV-VERSION", "GOV-OWNERSHIP", "GOV-A11Y", "GOV-SECURITY", "GOV-READINESS", "GOV-CONFIDENCE", "GOV-DEPTH"],
  "canonical_skill": "skills/lottie/SKILL.md",
  "modules": [
    {"id": "lottie.core", "source": "skills/lottie/SKILL.md", "sections": ["Goal", "Version and Package Gate"], "load_when": ["implementation", "code-review", "debugging"]},
    {"id": "lottie.security", "source": "skills/lottie/SKILL.md", "sections": ["Security"], "load_when": ["security-review", "implementation"]},
    {"id": "lottie.a11y-ext", "source": "skills/lottie/SKILL.md", "sections": ["Accessibility"], "load_when": ["implementation", "accessibility-review"]}
  ],
  "workflows": ["implementation", "code-review", "debugging", "accessibility-review", "security-review", "production-readiness"],
  "example_tags": ["lottie"],
  "evidence_requirements": ["player package + version", "renderer (svg/canvas)", "asset origin/integrity"],
  "implementation_blockers": ["unknown player package", "untrusted asset origin"],
  "readiness_requirements": ["version verified", "destroy on unmount", "trusted asset source", "reduced-motion static fallback"]
}
