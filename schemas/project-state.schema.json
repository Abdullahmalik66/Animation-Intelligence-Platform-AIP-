{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnimationProjectState",
  "type": "object",
  "required": ["request_id", "raw_user_request", "user_mode"],
  "properties": {
    "request_id": {"type": "string"},
    "raw_user_request": {"type": "string"},
    "user_mode": {"enum": ["beginner", "guided", "expert"]},
    "normalised_intent": {"type": "string"},
    "animation_value_classification": {"enum": ["functional", "communicative", "decorative", "harmful", "unknown"]},
    "framework": {"type": ["string", "null"]},
    "framework_version": {"type": ["string", "null"]},
    "runtime": {"type": ["string", "null"]},
    "bundler": {"type": ["string", "null"]},
    "package_manager": {"type": ["string", "null"]},
    "installed_packages": {"type": "object"},
    "resolved_versions": {"type": "object"},
    "verified_exports": {"type": "object"},
    "assets": {"type": "array", "items": {"type": "object"}},
    "browser_support_policy": {"type": ["string", "null"]},
    "accessibility_policy": {"type": ["string", "null"]},
    "security_policy": {"type": ["string", "null"]},
    "performance_budget": {"type": ["object", "null"]},
    "selected_architecture": {"type": ["string", "null"]},
    "selected_technology": {"type": ["string", "null"]},
    "selected_workflow": {"type": ["string", "null"]},
    "selected_modules": {"type": "array", "items": {"type": "string"}},
    "selected_examples": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "implementation_readiness": {"enum": ["Ready", "Ready after Required Reviews", "Not Ready", "Insufficient Evidence", null]},
    "confidence": {"enum": ["High", "Medium", "Low", "Unknown", null]},
    "context_manifest": {"type": ["object", "null"]},
    "token_usage": {"type": ["object", "null"]},
    "validation_results": {"type": "array", "items": {"type": "object"}}
  }
}
