{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TechnologyManifest",
  "type": "object",
  "required": ["id", "purpose", "triggers", "exclusions", "required_shared_modules", "canonical_skill", "workflows"],
  "properties": {
    "id": {"type": "string"},
    "purpose": {"type": "string"},
    "triggers": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "required_shared_modules": {"type": "array", "items": {"type": "string"}},
    "canonical_skill": {"type": "string", "description": "Provenance: path to the monolithic SKILL.md that remains canonical"},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "sections", "load_when"],
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string"},
          "sections": {"type": "array", "items": {"type": "string"}},
          "load_when": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "workflows": {"type": "array", "items": {"type": "string"}},
    "example_tags": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "implementation_blockers": {"type": "array", "items": {"type": "string"}},
    "readiness_requirements": {"type": "array", "items": {"type": "string"}}
  }
}
